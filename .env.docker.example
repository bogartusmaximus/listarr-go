# Copy to .env for docker compose (never commit .env)

# Seeded into the store on first boot (edit later in Settings).
LISTARR_INSTANCE_NAME=listarr-docker

# Mutations stay off unless you opt in (seeds Safe Mode off).
# LISTARR_APPLY=1

# Optional TMDB for discover
# LISTARR_TMDB_API_KEY=

# Default store is polars (CSV + settings.json under the compose volume).
LISTARR_STORE_BACKEND=polars

# Postgres profile example (also: docker compose --profile postgres up --build)
# LISTARR_STORE_BACKEND=postgres
# LISTARR_DATABASE_URL=postgres://listarr:listarr@postgres:5432/listarr?sslmode=disable

# Reach *arr on the Docker host (Docker Desktop / host-network Linux).
LISTARR_ARR_LOCAL_URL=http://host.docker.internal:7878
LISTARR_ARR_LOCAL_API_KEY=
LISTARR_ARR_LOCAL_KIND=radarr
# LISTARR_ARR_REMOTE_URL=http://host.docker.internal:7879
# LISTARR_ARR_REMOTE_API_KEY=
# LISTARR_ARR_REMOTE_KIND=radarr
LISTARR_RADARR_URL=http://host.docker.internal:7878
LISTARR_RADARR_API_KEY=
LISTARR_SONARR_URL=http://host.docker.internal:8989
LISTARR_SONARR_API_KEY=

# API key is generated on first boot into the datastore (not env).
# Open the UI — Settings shows it masked (Show / Copy / Regenerate).
# Agents: docker compose exec listarr cat /data/polars/settings.json
