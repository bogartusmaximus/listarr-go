# Environment example (safe placeholders only)

# Required — generate a long random string; never commit the real value.
LISTARR_API_KEY=replace-me-with-a-long-random-string

# Loopback only by default.
LISTARR_LISTEN=127.0.0.1:8787
LISTARR_INSTANCE_NAME=listarr

# Mutations off unless explicitly enabled.
# LISTARR_APPLY=1

# TorBox-oriented search-on-add budget (rolling hour).
LISTARR_TORBOX_SEARCH_PER_HOUR=60

# Optional TMDB
# LISTARR_TMDB_API_KEY=

# Legacy single-instance aliases (register names "radarr" / "sonarr")
# LISTARR_RADARR_URL=http://127.0.0.1:7878
# LISTARR_RADARR_API_KEY=
# LISTARR_SONARR_URL=http://127.0.0.1:8989
# LISTARR_SONARR_API_KEY=

# Named instances for dual-homed sync (example names only — use your own)
# LISTARR_ARR_LOCAL_URL=http://127.0.0.1:7878
# LISTARR_ARR_LOCAL_API_KEY=
# LISTARR_ARR_LOCAL_KIND=radarr
# LISTARR_ARR_REMOTE_URL=http://127.0.0.1:7879
# LISTARR_ARR_REMOTE_API_KEY=
# LISTARR_ARR_REMOTE_KIND=radarr

# Store backends: polars (default CSV for tests) | postgres | sqlite/mysql (stubbed)
LISTARR_STORE_BACKEND=polars
# LISTARR_POLARS_DIR=data/polars
# LISTARR_STORE_BACKEND=postgres
# LISTARR_DATABASE_URL=postgres://listarr:replace-me@127.0.0.1:5432/listarr?sslmode=disable
