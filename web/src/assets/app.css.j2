{% include "_tokens.css.j2" %}
{% include "_reset.css.j2" %}
{% include "_layout.css.j2" %}
{% include "_forms.css.j2" %}

/* listarr-go layout tweaks */
.top {
  display: grid;
  gap: 1.5rem;
}
@media (min-width: 840px) {
  .top {
    grid-template-columns: 1.3fr 1fr;
    align-items: end;
  }
  .status-chip {
    border-left: 1px solid var(--line);
    padding-left: 1.5rem;
  }
}
.status-chip {
  display: grid;
  gap: 0.25rem;
  align-content: end;
}
main .panel h2 {
  font-size: 1.6rem;
  letter-spacing: -0.02em;
  text-transform: none;
  color: var(--ink);
}
.result-meta {
  margin-top: 1rem;
  padding: 0.75rem 0;
  border-top: 1px solid var(--line);
  font-weight: 600;
}
.library-pager {
  display: flex;
  gap: 0.75rem;
  align-items: center;
  margin: 0.5rem 0 1rem;
}
.settings-form { display: grid; gap: 1.25rem; }
.plex-pane { display: grid; gap: 0.65rem; }
.plex-actions { justify-content: flex-start; flex-wrap: wrap; }
.advanced-body[hidden],
.arr-advanced-body[hidden],
.busy[hidden],
#syncRootCustom[hidden] {
  display: none !important;
}
.advanced-body,
.arr-advanced-body {
  display: grid;
  gap: 0.75rem;
  padding-top: 0.35rem;
  border-top: 1px solid var(--line);
}
code { font-family: var(--font-mono); font-size: 0.9em; }
