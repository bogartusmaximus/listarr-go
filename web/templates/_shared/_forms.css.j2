{# Forms, tabs, buttons — listarr-go and other operator UIs. #}
.tabs {
  display: flex;
  gap: 0.35rem;
  flex-wrap: wrap;
  width: var(--content-width);
  margin-inline: auto;
  padding: 0.5rem 0 1rem;
  border-bottom: 1px solid var(--line);
}
.tab {
  border: 0;
  background: transparent;
  color: var(--muted);
  padding: 0.55rem 0.85rem;
  border-radius: var(--radius);
  font: inherit;
  font-weight: 600;
  cursor: pointer;
}
.tab.active {
  background: #143028;
  color: var(--accent);
  box-shadow: inset 0 -2px 0 var(--accent);
}
.panel {
  width: var(--content-width);
  margin-inline: auto;
  padding: 1.5rem 0 2.5rem;
}
.panel[hidden] { display: none !important; }
.field {
  display: grid;
  gap: 0.35rem;
  align-content: start;
  font-size: 0.92rem;
}
.field > span:first-child {
  font-weight: 600;
  color: var(--muted);
}
.field.check {
  grid-template-columns: auto 1fr;
  align-items: center;
  gap: 0.55rem;
}
input, select, button, textarea { font: inherit; }
input[type="text"],
input[type="password"],
input[type="number"],
input[type="url"],
input[type="search"],
select,
textarea {
  width: 100%;
  border: 1px solid var(--line);
  background: #0b1014;
  color: var(--ink);
  border-radius: var(--radius);
  padding: 0.55rem 0.7rem;
}
input:focus, select:focus, textarea:focus {
  outline: 2px solid var(--accent);
  outline-offset: 1px;
}
.btn {
  appearance: none;
  border: 1px solid var(--line);
  background: var(--panel);
  color: var(--ink);
  border-radius: var(--radius);
  padding: 0.55rem 1rem;
  font-weight: 600;
  cursor: pointer;
}
.btn:hover:not(:disabled) { border-color: var(--accent); }
.btn:disabled { opacity: 0.45; cursor: not-allowed; }
.btn.primary {
  background: var(--accent);
  border-color: var(--accent);
  color: #0f1419;
}
.btn.danger {
  background: var(--bad);
  border-color: var(--bad);
  color: var(--ink);
}
.btn-ghost {
  background: transparent;
  border-color: var(--line);
}
fieldset {
  margin: 0;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 1rem;
  display: grid;
  gap: 0.75rem;
  background: var(--panel);
}
legend {
  padding: 0 0.35rem;
  font-weight: 700;
  color: var(--ink);
}
.actions, .inline-form, .library-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.65rem;
  align-items: end;
}
.inline-form { margin-bottom: 1rem; }
.inline-form .field { min-width: 140px; }
.sync-form {
  display: grid;
  gap: 1.25rem;
  align-items: start;
}
@media (min-width: 840px) {
  .sync-form { grid-template-columns: 1fr 1fr; }
  .sync-form .actions, .sync-form .busy { grid-column: 1 / -1; }
}
.table-wrap {
  overflow-x: auto;
  margin-top: 1rem;
  border-top: 1px solid var(--line);
}
.results .action-add { color: var(--accent); font-weight: 700; }
.results .action-skip { color: var(--muted); }
.results .action-error { color: var(--bad); font-weight: 700; }
.toast {
  position: fixed;
  right: 1rem;
  bottom: 1rem;
  z-index: 20;
  max-width: min(420px, calc(100% - 2rem));
  padding: 0.85rem 1rem;
  background: var(--panel);
  color: var(--ink);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
}
.instance-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 0.45rem;
}
.instance-list li {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.55rem 0;
  border-bottom: 1px solid var(--line);
}
.secret-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  align-items: center;
}
.secret-row input { flex: 1 1 12rem; min-width: 0; }
.arr-instances { display: grid; gap: 1rem; }
.arr-row {
  display: grid;
  gap: 0.65rem;
  padding: 0.85rem 0;
  border-top: 1px solid var(--line);
}
.arr-row:first-child { border-top: 0; padding-top: 0; }
@media (min-width: 720px) {
  .arr-row {
    grid-template-columns: 1fr 7rem 1.4fr 1.4fr auto auto;
    align-items: end;
  }
}
.arr-advanced {
  grid-column: 1 / -1;
  display: grid;
  gap: 0.5rem;
  margin-top: 0.35rem;
  padding: 0.75rem;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: #0b1014;
}
.busy {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.85rem 0;
  border-top: 1px solid var(--line);
  font-weight: 600;
}
.busy p { margin: 0; }
.spinner {
  width: 1.1rem;
  height: 1.1rem;
  border: 2px solid var(--line);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  flex: 0 0 auto;
}
@keyframes spin { to { transform: rotate(360deg); } }
