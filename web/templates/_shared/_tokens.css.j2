{# Canonical homelab *-go / homepage palette (tdarr-server-go SoT). #}
:root {
  --bg: #0f1419;
  --panel: #182029;
  --ink: #e8eef2;
  --muted: #8aa0ad;
  --line: #2a3a46;
  --accent: #3dbe9a;
  --warn: #e0a14a;
  --bad: #d36b6b;
  --font: "IBM Plex Sans", "Segoe UI", sans-serif;
  --font-mono: "IBM Plex Mono", "SF Mono", Menlo, monospace;
  --radius: 4px;
  --content-width: min(1100px, calc(100% - 2rem));
}

